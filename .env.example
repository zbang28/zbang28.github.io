# Copy to .env for local dev. On Vercel, set these in the project settings
# (Neon auto-injects DATABASE_URL / POSTGRES_URL when you add the integration).

# Postgres connection string. Defaults to the local Docker DB if unset.
DATABASE_URL=postgres://postgres:dev@localhost:5433/fanhub

# Auth — CHANGE THIS in production to a long random string
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=30d

# Public origin of the frontend (used for CORS + Stripe redirect URLs)
CLIENT_URL=http://localhost:4000
PORT=4000

# Stripe (optional). Empty -> dev-unlock fallback for the paywall.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
UNLOCK_PRICE_CENTS=500
